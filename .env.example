# ----------------------------------------------------------------------------
# RUMA IT Support — environment configuration
# Copy to .env and fill in. NEVER commit .env.
# ----------------------------------------------------------------------------

APP_NAME="RUMA IT Support"
# local | production  (production hides error details)
APP_ENV=production
APP_DEBUG=false
# Full public URL, no trailing slash. Used in emails and redirects.
APP_URL=https://it.ruma.hospital
# PHP timezone identifier. All dates are stored and reported in this zone.
APP_TIMEZONE=UTC

# Database (on cPanel the names are prefixed, e.g. cpuser_ruma)
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=ruma_itsm
DB_USERNAME=ruma_app
DB_PASSWORD=

# Sessions
SESSION_NAME=ruma_sid
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
# auto = Secure cookie whenever the request is HTTPS. Use true in production.
SESSION_SECURE=auto

# Login protection
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
LOGIN_IP_MAX_ATTEMPTS=30

# Comma-separated proxy IPs whose X-Forwarded-For header is trusted
# (e.g. a load balancer). Leave empty if clients connect directly.
TRUSTED_PROXIES=

# Uploads
UPLOAD_MAX_MB=5

# Email (PHPMailer over SMTP). When MAIL_ENABLED=false, messages are written
# to storage/logs/mail.log instead of being sent.
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# tls | ssl | none
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=it-support@ruma.hospital
MAIL_FROM_NAME="RUMA IT Support"
